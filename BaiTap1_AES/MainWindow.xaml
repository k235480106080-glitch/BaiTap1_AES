<Window x:Class="BaiTap1_AES.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AES Security Engine v2.0 - AES-256 CBC" Height="780" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#0F172A">
    <Window.Resources>
        <!-- Style Button Chung -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡️ AES-256 CRYPTOGRAPHIC ENGINE" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                        <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="CBC + PKCS7" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Học phần: An toàn và bảo mật thông tin | Đồ án mã hóa đối xứng" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#0F172A" CornerRadius="8" Padding="12,8" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel TextElement.Foreground="#F1F5F9" TextElement.FontSize="12">
                        <TextBlock Text="👤 SV: Trần Hoàng Xuân Vũ" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text="🆔 MSSV: K235480106080" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- SECTION 1: KEY MANAGEMENT -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="16" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔑 QUẢN LÝ KHÓA" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <UniformGrid Grid.Column="1" Columns="3">
                    <Button Name="btnGenKey" Content="⚡ 1. Khởi Tạo Khóa Mới" Margin="4,0" Background="#2563EB" Click="BtnGenKey_Click"/>
                    <Button Name="btnSaveKey" Content="💾 2. Xuất Khóa Ra File" Margin="4,0" Background="#7C3AED" Click="BtnSaveKey_Click"/>
                    <Button Name="btnImportKey" Content="📂 3. Nạp Khóa Từ File" Margin="4,0" Background="#0D9488" Click="BtnImportKey_Click"/>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- MAIN BODY: 2 COLUMNS (TEXT ENCRYPTION & FILE BENCHMARK) -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- CARD LEFT: TEXT ENCRYPTION -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="10" Padding="16" BorderBrush="#334155" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="📝 MÃ HÓA VĂN BẢN (TEXT)" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Height="38" Margin="0,10,0,0">
                        <Button Name="btnEncryptText" Content="🔒 4a. Mã Hóa" Margin="0,0,4,0" Background="#E11D48" Click="BtnEncryptText_Click"/>
                        <Button Name="btnDecryptText" Content="🔓 4b. Giải Mã" Margin="4,0,0,0" Background="#059669" Click="BtnDecryptText_Click"/>
                    </UniformGrid>
                    <TextBox Name="txtInputText" Background="#0F172A" Foreground="#F1F5F9" BorderBrush="#334155" BorderThickness="1" 
                             Padding="10" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13" VerticalScrollBarVisibility="Auto"
                             Text="Trần Hoàng Xuân Vũ - K235480106080"/>
                </DockPanel>
            </Border>

            <!-- CARD RIGHT: FILE PROCESSOR & LARGE FILE BENCHMARK -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Padding="16" BorderBrush="#334155" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📁 MÃ HÓA FILE &amp; BENCHMARK FILE LỚN (GB)" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Name="btnEncryptFile" Grid.Column="0" Content="📦 5a. Mã Hóa File (.enc)" Height="40" Margin="0,0,5,0" Background="#9333EA" Click="BtnEncryptFile_Click"/>
                        <Button Name="btnDecryptFile" Grid.Column="1" Content="📂 5b. Giải Mã File (.dec)" Height="40" Margin="5,0,0,0" Background="#D97706" Click="BtnDecryptFile_Click"/>
                    </Grid>

                    <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,10,0,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🚀 Thử nghiệm hiệu năng với File hàng GB" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                            <TextBlock Text="Mã hóa luồng (Streaming CryptoStream 1MB Buffer) + So sánh Byte-by-Byte trực tiếp." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Name="btnBenchmark" Content="⚡ CHẠY BENCHMARK &amp; SO SÁNH BYTE-BY-BYTE" Height="42" Background="#2563EB" Click="BtnBenchmark_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SECTION 3: TERMINAL LOG CONSOLE -->
        <Border Grid.Row="3" Background="#090D16" CornerRadius="10" Padding="12" BorderBrush="#1E293B" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button Name="btnClearLog" Content="🧹 Xóa Log" DockPanel.Dock="Right" Width="80" Height="26" FontSize="11" Background="#334155" Click="BtnClearLog_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0"/>
                        <TextBlock Text="SYSTEM LOG CONSOLE" Foreground="#64748B" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </DockPanel>
                <RichTextBox Name="rtbLog" Grid.Row="1" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" 
                             FontFamily="Consolas" FontSize="12.5" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>